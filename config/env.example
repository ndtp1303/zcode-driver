# Copy to a file that is not committed, then export it.
# The remote link is a credential. Never commit a real sid or mid.

ZCODE_REMOTE_URL=https://zcode.z.ai/remote/v4?sid=SESSION&mid=MACHINE&name=MACHINE-NAME&app_version=3.16.3

# Same ZCode account that is signed in on the desktop. The page reads this
# JWT from localStorage; the relay rejects the socket without it.
ZCODE_JWT=

# Optional. The page only checks that this string is non-empty before it
# leaves the sign-in screen. The relay itself uses ZCODE_JWT.
# ZCODE_ACCESS_TOKEN=
# ZCODE_PROVIDER=zai
# ZCODE_USER_INFO={"id":"...","username":"...","displayName":"..."}

# Optional Chrome/Chromium binary. playwright-core does not download a browser.
# ZCODE_CHROME=/usr/bin/google-chrome
# ZCODE_CHROME_NO_SANDBOX=1
